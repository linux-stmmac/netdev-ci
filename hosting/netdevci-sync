#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Mirror results/ of the netdev-ci repo into the web root
set -eu

REPO_URL=${REPO_URL:-https://github.com/linux-stmmac/netdev-ci.git}
BRANCH=${BRANCH:-main}
SUBDIR=${SUBDIR:-results}
DEST=${DEST:-/var/www/netdevci/stmmac}
STATE=${STATE_DIRECTORY:-/var/lib/netdevci-sync}

repo=$STATE/repo.git
stage=$STATE/stage

[ -d "$repo" ] || git init -q --bare "$repo"
git -C "$repo" fetch -q --depth 1 --no-tags "$REPO_URL" \
	"+refs/heads/$BRANCH:refs/heads/$BRANCH"
head=$(git -C "$repo" rev-parse "refs/heads/$BRANCH")

if [ -d "$DEST" ] && [ "$(cat "$STATE/deployed" 2>/dev/null)" = "$head" ]; then
	exit 0
fi

if ! git -C "$repo" cat-file -e "$head:$SUBDIR" 2>/dev/null; then
	echo "netdevci-sync: $head has no $SUBDIR/"
	exit 0
fi

rm -rf "$stage"
mkdir -p "$stage"
git -C "$repo" archive --format=tar "$head" "$SUBDIR/" |
	tar -x -C "$stage" --no-same-owner --no-same-permissions

# Regular files only, no dotfiles at any depth.
src=$stage/$SUBDIR
find "$src" -mindepth 1 -name '.*' -prune -exec rm -rf -- {} +
find "$src" ! -type f ! -type d -delete
find "$src" -type d -exec chmod 755 {} +
find "$src" -type f -exec chmod 644 {} +

mkdir -p "$DEST"
listing() {
	(cd "$1" && find . -mindepth 1 -printf '%y %p\0' | sort -z)
}
listing "$src" >"$STATE/want"
listing "$DEST" >"$STATE/have"
comm -z -23 "$STATE/have" "$STATE/want" | sed -z 's/^. //' |
	(cd "$DEST" && xargs -0 -r rm -rf --)

{
	comm -z -13 "$STATE/have" "$STATE/want" | sed -z -n 's|^f \./||p'
	if old=$(git -C "$repo" rev-parse -q --verify refs/deployed); then
		git -C "$repo" diff --name-only -z --no-renames "$old" "$head" -- "$SUBDIR/" ||
			git -C "$repo" ls-tree -r -z --name-only "$head" -- "$SUBDIR/"
	fi | sed -z "s|^$SUBDIR/||"
} | SRC=$src DEST=$DEST xargs -0 -r sh -c '
	for rel; do
		[ -f "$SRC/$rel" ] && [ ! -L "$SRC/$rel" ] || continue
		dir=$(dirname "$DEST/$rel")
		mkdir -p "$dir"
		cp --preserve=mode,timestamps "$SRC/$rel" "$dir/.netdevci-sync.tmp"
		mv -f "$dir/.netdevci-sync.tmp" "$DEST/$rel"
	done' sh

rm -rf "$stage" "$STATE/want" "$STATE/have"
git -C "$repo" update-ref refs/deployed "$head"
echo "$head" >"$STATE/deployed"
git -C "$repo" gc --auto -q
echo "netdevci-sync: published $head"
