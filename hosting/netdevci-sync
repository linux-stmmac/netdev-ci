#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Mirror results/ of the netdev-ci repo into the web root
set -eu

REPO_URL=${REPO_URL:-https://github.com/linux-stmmac/netdev-ci.git}
BRANCH=${BRANCH:-main}
SUBDIR=${SUBDIR:-results}
DEST=${DEST:-/var/www/netdevci/stmmac}
STATE=${STATE_DIRECTORY:-/var/lib/netdevci-sync}

for tool in git rsync; do
	if ! command -v "$tool" >/dev/null; then
		echo "netdevci-sync: $tool is not installed" >&2
		exit 1
	fi
done

repo=$STATE/repo.git
tree=$STATE/tree

[ -d "$repo" ] || git init -q --bare "$repo"
git -C "$repo" fetch -q --depth 1 --no-tags "$REPO_URL" \
	"+refs/heads/$BRANCH:refs/heads/$BRANCH"
head=$(git -C "$repo" rev-parse "refs/heads/$BRANCH")

if [ -d "$DEST" ] && [ "$(cat "$STATE/deployed" 2>/dev/null)" = "$head" ]; then
	exit 0
fi

if ! git -C "$repo" cat-file -e "$head:$SUBDIR" 2>/dev/null; then
	echo "netdevci-sync: $head has no $SUBDIR/"
	exit 0
fi

# A checkout that persists from one run to the next: git rewrites only what
# changed, so the other files keep their mtime and rsync leaves them alone.
[ -f "$STATE/index" ] || rm -rf "$tree"
mkdir -p "$tree"
GIT_DIR=$repo GIT_WORK_TREE=$tree GIT_INDEX_FILE=$STATE/index \
	git read-tree --reset -u "$head"

src=$tree/$SUBDIR
if [ -z "$(find "$src" -mindepth 1 -name '.*' -prune -o -type f -print -quit)" ]; then
	echo "netdevci-sync: $head has no file to publish, web root left as it is" >&2
	exit 1
fi

# Regular files only (no symlinks, devices or fifos), no dotfiles at any
# depth; updates land together at the end and deletions after them.
mkdir -p "$DEST"
rsync --quiet --recursive --times --perms --chmod=D755,F644 \
	--no-links --no-devices --no-specials \
	--exclude='.*' --delete-delay --delete-excluded --delay-updates \
	"$src/" "$DEST/"

echo "$head" >"$STATE/deployed"
git -C "$repo" gc --auto -q
echo "netdevci-sync: published $head"
